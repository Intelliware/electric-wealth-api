# Copy to .env and adjust as needed. All values are optional.

# Port the API listens on. The Node API uses 4100, so the two can run side by side.
PORT=4200

# Path to the SQLite database file, relative to this repo (or absolute).
# Default: the sibling electric-wealth-db repo's database.
DB_PATH=../electric-wealth-db/data/electric-wealth.db

# Browser origins allowed by CORS (comma-separated). The web app's Vite dev server is 5173.
CORS_ORIGINS=http://localhost:5173
